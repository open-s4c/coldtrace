#!/bin/sh
COLDTRACE_SCRIPTS="$(readlink -f $(dirname $(readlink -f $0)))"
COLDTRACE_ROOT="$(readlink -f $COLDTRACE_SCRIPTS/..)"
COLDTRACE_BUILD="${COLDTRACE_BUILD:-$COLDTRACE_ROOT/build}"

export TSANO_LIBDIR="$COLDTRACE_BUILD/deps/dice/deps/tsano"
if [ "$(uname)" = Darwin ]; then
    SOEXT=.dylib
else
    SOEXT=.so
fi
SOEXT="${COLDTRACE_LIBRARY_SUFFIX:-$SOEXT}"
PRELOAD="$COLDTRACE_BUILD/src/libcoldtrace$SOEXT"
TSANO="${COLDTRACE_DICE_SOURCE:-$COLDTRACE_ROOT/../dice}/deps/tsano/tsano"

run_coldtrace()
{
    if [ "$(uname)" = Darwin ]; then
        env DYLD_LIBRARY_PATH="$TSANO_LIBDIR${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}" \
            DYLD_INSERT_LIBRARIES="$PRELOAD" "$@"
    else
        "$TSANO" env LD_PRELOAD="$PRELOAD" "$@"
    fi
}

ensure_traces=false
if [ "${1:-}" = -ensure-traces ]; then
    ensure_traces=true
    shift
fi
run_coldtrace "$@"
status=$?
if [ "$status" -ne 0 ]; then
    exit "$status"
fi
if [ "$ensure_traces" = true ]; then
    "$COLDTRACE_SCRIPTS/traces-nonempty.sh" "$COLDTRACE_PATH"
fi
